{
  "name": "@corbits/mailbox",
  "version": "0.2.0",
  "description": "A native Interchange mailbox for human principals, mountable onto any Interchange host. Requires @intx 0.4.0 or newer.",
  "keywords": [
    "corbits",
    "drizzle",
    "hono",
    "inbox",
    "interchange",
    "intx",
    "mailbox",
    "postgres"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-mailbox#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-mailbox/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-mailbox.git"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@corbits/mailbox-0.1.0": "npm:@corbits/mailbox@0.1.0",
    "@hono/standard-validator": "0.2.3",
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@intx/log": "0.4.0",
    "@intx/mailbox": "0.4.0",
    "@intx/mime": "0.4.0",
    "@intx/types": "0.4.0",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "@types/bun": "1.1.14",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.10.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.32",
    "hono-openapi": "1.3.1",
    "openapi-types": "12.1.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postgres": "3.4.9",
    "typescript": "5.7.2"
  },
  "peerDependencies": {
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "@intx/log": "^0.4.0",
    "@intx/mailbox": "^0.4.0",
    "@intx/mime": "^0.4.0",
    "@intx/types": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.0",
    "hono-openapi": "^1.3.1",
    "postgres": "^3.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
