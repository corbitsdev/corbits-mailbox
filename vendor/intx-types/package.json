{
  "name": "@intx/types",
  "description": "Runtime validators, API contract types, runtime interfaces, and sidecar wire frames for Interchange",
  "version": "0.3.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./authz": {
      "types": "./src/authz.ts",
      "default": "./src/authz.ts"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./src/audit.ts"
    },
    "./content-type": {
      "types": "./src/content-type.ts",
      "default": "./src/content-type.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./runtime-capabilities": {
      "types": "./src/runtime-capabilities.ts",
      "default": "./src/runtime-capabilities.ts"
    },
    "./sidecar": {
      "types": "./src/sidecar.ts",
      "default": "./src/sidecar.ts"
    },
    "./grant-wire": {
      "types": "./src/grant-wire.ts",
      "default": "./src/grant-wire.ts"
    },
    "./tool-packages": {
      "types": "./src/tool-packages.ts",
      "default": "./src/tool-packages.ts"
    },
    "./package-json": {
      "types": "./src/package-json.ts",
      "default": "./src/package-json.ts"
    },
    "./wire-definition-hash": {
      "types": "./src/wire-definition-hash.ts",
      "default": "./src/wire-definition-hash.ts"
    },
    "./workflow-sources": {
      "types": "./src/workflow-sources.ts",
      "default": "./src/workflow-sources.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "arktype": "2.1.29",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "@types/semver": "^7.7.1",
    "typescript": "5.7.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
